#!/bin/sh
# session/window picker, Tab toggles lists. Lines are "window_id<TAB>session_id<TAB>name<TAB>note", only the name is searched

t=$(printf '\t')
esc=$(printf '\033')

list() {
  cur=$(tmux display-message -p '#{session_id}')
  {
    tmux list-sessions -F "s$t#{?#{==:#{session_id},$cur},1,0}$t#{session_last_attached}$t#{session_id}$t#{window_id}$t#{session_name}$t#{session_windows}" |
      sort -t "$t" -k2,2n -k3,3nr
    [ "$1" = windows ] &&
      tmux list-windows -a -F "w$t#{&&:#{==:#{session_id},$cur},#{window_active}}$t#{session_id}$t#{window_id}$t#{window_index}$t#{window_name}$t#{pane_current_command}"
  } | awk -F "$t" -v view="$1" -v width="$((${FZF_COLUMNS:-$(tput cols)} - 9))" '
    BEGIN { bold = "\033[1m"; dim = "\033[2m" }
    # NOTE: Pads the name so the note sits right-aligned; --tabstop=1 renders the tab as one column
    function row(wid, sid, indent, text, note, style,    pad) {
      pad = width - indent - length(text) - length(note)
      if (pad < 1) pad = 1
      return sprintf("%s\t%s\t%*s%s%s\033[22m%*s\t\033[2m%s\033[22m\n", wid, sid, indent, "", style, text, pad, "", note)
    }
    $1 == "s" {
      order[++n] = $4
      if (view == "sessions") line[$4] = row($5, $4, 0, $6, ($2 ? "current  " : "") $7 "w", $2 ? dim : "")
      else line[$4] = row($5, $4, 0, $6, $7 "w", bold)
    }
    $1 == "w" { line[$3] = line[$3] row($4, $3, 2, $5 ": " $6, ($2 ? "current  " : "") $7, $2 ? dim : "") }
    END { for (i = 1; i <= n; i++) printf "%s", line[order[i]] }'
}

label() {
  on="$esc[1;32m"; off="$esc[2m"
  [ "$1" = windows ] && { on="$esc[2m"; off="$esc[1;32m"; }
  printf ' %sSessions%s  %sWindows%s ' "$on" "$esc[0m" "$off" "$esc[0m"
}

case $1 in
list) list "$2" ;;
toggle)
  case $FZF_INPUT_LABEL in
  *"$esc[1;32mSessions"*) next=windows ;;
  *) next=sessions ;;
  esac
  printf 'change-input-label(%s)+reload(%s list %s)' "$(label "$next")" "$0" "$next" ;;
*)
  list sessions | fzf --ansi --no-sort --delimiter '\t' --with-nth=3,4 --nth=1 --tabstop=1 \
    --info=inline-right --color=prompt:2,bg+:#2a2822,fg+:-1 --scrollbar='▐' --pointer=' ' \
    --highlight-line --input-border=sharp --list-border=sharp --input-label "$(label sessions)" \
    --bind "tab:transform:$0 toggle" \
    --bind 'enter:become(tmux select-window -t {1} \; switch-client -t {2})' ;;
esac
