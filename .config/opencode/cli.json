{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "flora"
  },
  "attention": {
    "sound_pack": "opencode.default"
  },
  "diffs": {
    "wrap": "word",
    "view": "split"
  },
  "terminal": {
    "title": true
  },
  "prompt": {
    "paste": "compact"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "show",
    "grouping": "auto"
  },
  "animations": true,
  "plugins": ["./tui-plugins/tmux-navigator.js"],
  "keybinds": {
    "leader": "ctrl+o",
    "input.newline": "return",
    "input.submit": "ctrl+return",
    "input.delete.to.line.end": "none",
    "dialog.select.prev": "up,ctrl+p,ctrl+k",
    "dialog.select.next": "down,ctrl+n,ctrl+j",
    "prompt.autocomplete.prev": "up,ctrl+p,ctrl+k",
    "prompt.autocomplete.next": "down,ctrl+n,ctrl+j",
    "prompt.editor": "<leader>e",
    "session.sidebar.toggle": "<leader>b"
  },
  "tabs": {
    "layout": "horizontal"
  }
}
