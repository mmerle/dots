{
  "$schema": "https://opencode.ai/config.json",
  "update": "disable",
  "plugins": ["opencode-rules@latest"],
  "mcp": {
    "servers": {
      "arena": {
        "type": "remote",
        "url": "https://mcp.are.na/mcp",
        "disabled": true,
      },
      "astro-docs": {
        "type": "remote",
        "url": "https://mcp.docs.astro.build/mcp",
        "disabled": true,
      },
      "chrome-devtools": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "chrome-devtools-mcp@latest",
          "--channel=canary",
          "--headless=true",
          "--isolated=true",
        ],
        "disabled": true,
      },
      "cloudflare-api": {
        "type": "remote",
        "url": "https://mcp.cloudflare.com/mcp",
        "disabled": true,
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp/oauth",
      },
      "playwright": {
        "type": "local",
        "command": ["npx", "-y", "@playwright/mcp@latest"],
        "disabled": true,
      },
      "sanity": {
        "type": "remote",
        "url": "https://mcp.sanity.io",
        "disabled": true,
      },
      "svelte": {
        "type": "remote",
        "url": "https://mcp.svelte.dev/mcp",
        "disabled": true,
      },
    },
  },
}
