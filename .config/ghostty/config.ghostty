theme = flora-dark

macos-option-as-alt = true
macos-titlebar-style = hidden
macos-shortcuts = allow
macos-icon = custom-style
macos-icon-ghost-color = #ffffff
macos-icon-screen-color = #000000

font-family = MD IO Variable
font-feature = calt
font-size = 13
adjust-cell-height = 40%
adjust-cursor-height = 40%

confirm-close-surface = false
bell-features = no-title, no-attention, no-audio
mouse-hide-while-typing = true
mouse-shift-capture = true
quit-after-last-window-closed = true
clipboard-read = allow
clipboard-write = allow
copy-on-select = clipboard
cursor-style-blink = false
cursor-invert-fg-bg = true
shell-integration-features = title, sudo, no-cursor

resize-overlay = never
window-colorspace = display-p3
window-padding-balance = true
window-padding-x = 10
window-padding-y = 10
window-padding-color = background

# \x02 is ctrl+b (tmux)
keybind = super+digit_1=text:\x021
keybind = super+digit_2=text:\x022
keybind = super+digit_3=text:\x023
keybind = super+digit_4=text:\x024
keybind = super+digit_5=text:\x025

keybind = super+w=text:\x02x
keybind = super+t=text:\x02c
keybind = super+f=text:\x02\x05
keybind = super+g=text:\x02g
keybind = super+d=text:\x02%
keybind = super+shift+d=text:\x02"

# vim:ft=conf
