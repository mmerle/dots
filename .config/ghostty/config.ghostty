theme = light:flora-light, dark:flora-dark

macos-option-as-alt = true
macos-titlebar-style = hidden
macos-shortcuts = allow
macos-icon = custom-style
macos-icon-ghost-color = #ffffff
macos-icon-screen-color = #000000
auto-update = off

font-family = MD IO Variable
font-feature = calt
font-size = 13
adjust-cell-height = 40%
adjust-cursor-height = 40%

confirm-close-surface = false
bell-features = no-title, no-attention, no-audio
mouse-hide-while-typing = true
mouse-shift-capture = true
quit-after-last-window-closed = true
clipboard-read = allow
clipboard-write = allow
copy-on-select = clipboard
cursor-style-blink = false
cursor-invert-fg-bg = true
shell-integration-features = title, sudo, no-cursor
quick-terminal-animation-duration = 0
quick-terminal-screen = macos-menu-bar
resize-overlay = never
window-colorspace = display-p3
window-padding-balance = true
window-padding-x = 10
window-padding-y = 10
window-padding-color = background

# \x02 is ctrl+b (tmux)
keybind = super+digit_1=text:\x021
keybind = super+digit_2=text:\x022
keybind = super+digit_3=text:\x023
keybind = super+digit_4=text:\x024
keybind = super+digit_5=text:\x025
keybind = super+digit_6=text:\x026
keybind = super+digit_7=text:\x027
keybind = super+digit_8=text:\x028
keybind = super+digit_9=text:\x029

keybind = super+w=text:\x02x
keybind = super+t=text:\x02c
keybind = super+f=text:\x02\x05
keybind = super+g=text:\x02g
keybind = super+d=text:\x02%
keybind = super+shift+d=text:\x02"

keybind = global:super+alt+ctrl+grave_accent=toggle_quick_terminal

# vim:ft=conf
